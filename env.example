# Copie para .env e preencha. O .env NÃO vai para o Git.
#
# Gere a chave com:
#   python -c "import secrets,string; a=string.ascii_letters+string.digits+'-_'; print(''.join(secrets.choice(a) for _ in range(50)))"
# (sem caracteres especiais, para o .env poder ser lido por scripts de shell)
# Sem ela e com DJANGO_DEBUG=False, o sistema se recusa a subir.

DJANGO_SECRET_KEY=troque-por-uma-chave-gerada

# False em produção. Com True, as páginas de erro expõem o código.
DJANGO_DEBUG=False

# Inclua o domínio por onde o site é acessado.
DJANGO_ALLOWED_HOSTS=relig.simoesti.com.br,localhost,127.0.0.1,0.0.0.0,web

# O projeto usa SQLite (cantina/settings.py). Esta variável fica aqui para
# quando migrar para Postgres.
DATABASE_URL=postgres://app:app@db:5432/app
